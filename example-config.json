{
  "description": "Example configuration for Headers & Cookies Manager",
  "headers": [
    {
      "key": "Authorization",
      "value": "Bearer YOUR_TOKEN_HERE"
    },
    {
      "key": "X-API-Key",
      "value": "your-api-key"
    },
    {
      "key": "User-Agent",
      "value": "CustomAgent/1.0"
    },
    {
      "key": "Content-Type",
      "value": "application/json"
    },
    {
      "key": "X-Custom-Header",
      "value": "custom-value"
    }
  ],
  "cookies": [
