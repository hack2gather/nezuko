      "key": "sessionId",
      "value": "abc123def456ghi789"
    },
    {
      "key": "userId",
      "value": "12345"
    },
    {
      "key": "authToken",
      "value": "xyz789uvw456rst123"
    },
    {
      "key": "preferences",
      "value": "theme=dark;lang=en"
    }
  ],
  "notes": [
    "This is an example configuration file",
    "Copy the headers and cookies you need into the plugin UI",
    "Do NOT commit sensitive tokens to version control",
    "Replace placeholder values with your actual values"
  ]
