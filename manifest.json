{
  "id": "caido-headers-sidebar",
  "name": "Headers & Cookies Manager",
  "version": "1.0.0",
  "description": "Manage custom headers and cookies with a sidebar UI. Automatically apply them to Repeater requests.",
  "author": {
    "name": "Caido Plugin Developer",
    "email": "dev@example.com"
  },
  "plugins": [
    {
      "kind": "frontend",
      "id": "headers-sidebar-frontend",
      "name": "Headers Sidebar Frontend",
      "entrypoint": "frontend.js",
      "style": "styles.css",
      "backend": {
        "id": "headers-sidebar-backend"
      }
    },
    {
      "kind": "backend",
      "id": "headers-sidebar-backend",
      "name": "Headers Sidebar Backend",
      "runtime": "javascript",
      "entrypoint": "backend.js"
    }
  ]
}
